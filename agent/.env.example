# Kopiere diese Datei nach .env und trage deinen Schlüssel ein.
# Die .env wird nie hochgeladen (.gitignore).

# ---------------------------------------------------------------
# Welcher Anbieter? nvidia | anthropic | ollama | openai | groq
# ---------------------------------------------------------------
#  nvidia    = kostenlos (build.nvidia.com), wie im Video. Gut, aber
#              bei Werkzeug-Aufrufen weniger zuverlässig als Claude.
#  anthropic = Claude. Am stärksten bei Code-Analyse, kostet pro Nutzung.
#  ollama    = komplett lokal und offline. Braucht ein Modell mit
#              Tool-Calling (z. B. qwen3) – `ollama list` zeigt deine Modelle.
LLM_ANBIETER=nvidia

# Hauptmodell + Ersatzmodelle (kommagetrennt), falls das erste ausfällt
MODELL=moonshotai/kimi-k3
FALLBACK_MODELLE=openai/gpt-oss-120b,minimaxai/minimax-m3

NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxx
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
# OPENAI_API_KEY=sk-xxxxxxxx
# GROQ_API_KEY=gsk_xxxxxxxx

# Beispiele für andere Anbieter:
#   LLM_ANBIETER=anthropic   MODELL=claude-sonnet-5-5   FALLBACK_MODELLE=claude-haiku-5-5
#   LLM_ANBIETER=ollama      MODELL=qwen3:8b            FALLBACK_MODELLE=
#   (Ollama: Kontextfenster mit OLLAMA_NUM_CTX=16384 einstellbar.
#    Denkmodelle wie qwen3 denken standardmäßig NICHT laut nach – viel schneller.
#    Einschalten mit OLLAMA_DENKEN=an)

# Optional: eigene OpenAI-kompatible Adresse (überschreibt den Anbieter-Standard)
# BASE_URL=

# Lokales Embedding-Modell (mehrsprachig, versteht Deutsch + Code).
# Beim ersten Start einmalig ~2,3 GB Download, danach offline.
EMBED_MODEL=BAAI/bge-m3
